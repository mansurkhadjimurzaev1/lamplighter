; Последний фонарщик — проект Godot 4.7
config_version=5

[application]

config/name="Lamplighter"
config/name_localized={
"en": "The Last Lamplighter",
"ru": "Последний фонарщик"
}
config/description="Атмосферное приключение: старый фонарщик зажигает маяки в мире под Пеленой."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.027, 0.039, 0.1, 1)

[shader_globals]

hero_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
lantern_pos={
"type": "vec3",
"value": Vector3(0, -100, 0)
}
beacon_0={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beacon_1={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beacon_2={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beacon_3={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beacon_4={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
beacon_wave={
"type": "vec4",
"value": Vector4(0, 0, 0, -1)
}
